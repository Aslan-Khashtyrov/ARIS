{
  "version": "0.5",
  "mode": "monitoring_and_paper_only",
  "real_trading": false,
  "spot": {
    "assets": [
      "BTC",
      "ETH",
      "SOL",
      "XRP",
      "DOGE",
      "ADA",
      "AVAX",
      "DOT",
      "LINK",
      "LTC",
      "BCH",
      "TRX"
    ],
    "quote": "USD",
    "exchanges": [
      "coinbase",
      "kraken",
      "binance",
      "bybit",
      "okx"
    ],
    "public_market_data_only": true,
    "fee_assumptions": {
      "coinbase": 0.006,
      "kraken": 0.008,
      "binance": 0.001,
      "bybit": 0.001,
      "okx": 0.001
    },
    "quote_assets": [
      "USD",
      "USDT",
      "USDC",
      "EUR",
      "GBP",
      "DAI",
      "FDUSD"
    ],
    "universe_policy": "liquid_spot_assets_only"
  },
  "p2p": {
    "fiat": "RUB",
    "assets": [
      "USDT",
      "BTC"
    ],
    "minimum_completion_rate_percent": 95,
    "minimum_completed_orders": 50,
    "providers": {
      "binance": {
        "enabled": false,
        "reason": "No documented official public ads API"
      },
      "bybit": {
        "enabled": false,
        "reason": "Official P2P API requires General Advertiser status or above"
      },
      "okx": {
        "enabled": false,
        "reason": "Official P2P API requires eligible merchant status"
      }
    }
  },
  "safety": {
    "allow_shell": false,
    "allow_orders": false,
    "allow_payments": false,
    "allow_withdrawals": false,
    "allow_api_secrets_in_repo": false
  },
  "paper_wallet": {
    "enabled": true,
    "real_money": false,
    "initial_balances": {
      "binance:USDT": 1000,
      "bybit:USDT": 1000,
      "okx:USDT": 1000
    },
    "minimum_confirmations": 3,
    "minimum_profit_percent": 0.1,
    "risk_controls": {
      "maximum_trade_allocation_percent": 25,
      "maximum_trades_per_wallet_per_day": 20,
      "maximum_daily_drawdown_percent": 2
    }
  }
}
